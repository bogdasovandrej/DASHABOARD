# Скопируйте этот файл в .env и оставьте один из вариантов. Файл .env в git не попадает.

# Вариант 1. GigaChat. Ключ авторизации берётся в личном кабинете developers.sber.ru (проект GigaChat API).
GIGACHAT_KEY=
GIGACHAT_MODEL=GigaChat-2-Pro
# путь к сертификату Минцифры (russian_trusted_root_ca.cer). Без него проверка сертификата отключается.
GIGACHAT_CA=

# Вариант 2. Любой сервис с OpenAI-совместимым API.
# YandexGPT:  LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1   LLM_MODEL=gpt://<id каталога>/yandexgpt/latest
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1             LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Пароль для webhook.py (заголовок x-token)
WEBHOOK_TOKEN=

# Почта, куда Яндекс Формы шлют ответы. Пароль приложения создаётся в id.yandex.ru, обычный пароль не подходит.
YANDEX_MAIL=
YANDEX_APP_PASSWORD=
